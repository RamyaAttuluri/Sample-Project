# Contact form -> Microsoft Graph (Outlook / Microsoft 365) mailer.
# Copy to .env.local and fill in. NEVER commit real values, and NEVER prefix
# these with NEXT_PUBLIC_ (that would ship them to the browser).
# Setup guide: docs/contact-email-setup.md

# Microsoft Entra ID app registration (OAuth 2.0 client credentials)
MICROSOFT_TENANT_ID=your_tenant_id
MICROSOFT_CLIENT_ID=your_client_id
MICROSOFT_CLIENT_SECRET=your_client_secret

# Mailbox the app sends FROM (must be a licensed/shared Exchange Online mailbox)
OUTLOOK_SENDER_EMAIL=techops1@yourcompany.com
# Inbox that receives new-inquiry notifications
COMPANY_RECEIVER_EMAIL=techops1@yourcompany.com
# Optional: public contact address shown in the customer email footer and used
# as its Reply-To. Defaults to OUTLOOK_SENDER_EMAIL.
COMPANY_CONTACT_EMAIL=

COMPANY_NAME=GGST Innovations Private Limited
COMPANY_WEBSITE=https://ggstinnovations.com

# Optional: extra comma-separated origins allowed to POST to the API
# (same-host requests are always allowed), e.g. https://www.ggstinnovations.com
CONTACT_ALLOWED_ORIGINS=
